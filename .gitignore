# Build output, all regenerable by tools/build-pdf.mjs. The PDF ships as a
# GitHub release asset rather than a committed file, so that the repository
# does not gain a ~3 MB binary on every revision.
build/
SemOps-Manual*.pdf

# Toolchain
tools/node_modules/
node_modules/

# Evidence: environments, downloaded binaries and scratch output, all recreatable
# (see evidence/README.md). outputs/, manual/ and EVIDENCE.md are committed.
evidence/.venv/
evidence/bin/
evidence/node_modules/
evidence/work/

# Python bytecode
__pycache__/
